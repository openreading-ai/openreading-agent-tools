{
  "name": "openreading-local",
  "owner": {
    "name": "OpenReading"
  },
  "plugins": [
    {
      "name": "openreading-local-documents",
      "version": "0.2.0-alpha.17",
      "description": "Connect Claude to your OpenReading Core server. Native file selection, document tools and settings. No bundled parser or model download. Development candidate.",
      "author": {
        "name": "OpenReading"
      },
      "source": {
        "source": "archive",
        "url": "https://api.github.com/repos/openreading-ai/openreading-agent-tools/releases/assets/581481871",
        "sha256": "c30af7b6909de52d274d0a9b9f7aab26bc6eda19f101acf8f264be6c6024d41f"
      },
      "strict": false,
      "skills": "./skills",
      "mcpServers": {
        "openreading": {
          "command": "/bin/sh",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/launch.sh",
            "--chat-documents"
          ]
        },
        "openreading-settings": {
          "command": "/bin/sh",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/launch.sh",
            "--settings-tools"
          ]
        }
      },
      "headers": {
        "Accept": "application/octet-stream"
      },
      "headersHelper": "gh auth token --hostname github.com | jq -R '{Authorization: (\"Bearer \" + .)}'"
    }
  ],
  "description": "OpenReading server connectors for local agent clients."
}
