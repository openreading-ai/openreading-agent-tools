{
  "name": "openreading",
  "owner": {
    "name": "OpenReading"
  },
  "plugins": [
    {
      "name": "openreading",
      "version": "0.2.0-alpha.19",
      "description": "Connect Claude to your OpenReading Core server. Native file selection, document tools and settings. No bundled parser or model download. Development candidate.",
      "author": {
        "name": "OpenReading"
      },
      "source": {
        "source": "archive",
        "url": "https://api.github.com/repos/openreading-ai/openreading-agent-tools/releases/assets/581717952",
        "sha256": "79588a5bf916f5c5605e6258f7999fc37bb685f84f508563db6b18925accc582"
      },
      "strict": false,
      "skills": "./skills",
      "mcpServers": {
        "openreading": {
          "command": "/bin/sh",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/launch.sh",
            "--chat-documents"
          ]
        },
        "openreading-settings": {
          "command": "/bin/sh",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/launch.sh",
            "--settings-tools"
          ]
        }
      },
      "headers": {
        "Accept": "application/octet-stream"
      },
      "headersHelper": "gh auth token --hostname github.com | jq -R '{Authorization: (\"Bearer \" + .)}'"
    }
  ],
  "description": "OpenReading server connectors for local agent clients."
}
