{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "docs/**",
    "**/.venv/**",
    "dist/**",
    "build/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": [
        "img",
        "br"
      ]
    },
    "MD041": false,
    "MD060": false
  }
}
